{
  "name": "react-pdf-monorepo",
  "version": "1.0.0",
  "description": "react-pdf monorepo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "test"
  ],
  "scripts": {
    "build": "npm run build -w react-pdf",
    "dev": "npm run watch -w react-pdf && npm run dev -w test",
    "format": "npm run format",
    "lint": "npm run lint",
    "test": "npm run test",
    "tsc": "npm run tsc",
    "unit": "npm run unit"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0"
  },
  "resolutions": {
    "pdfjs-dist": "patch:pdfjs-dist@npm:4.4.168#.yarn/patches/pdfjs-dist-npm-4.4.168-35a0e70ced.patch"
  },
  "packageManager": "npm@10.8.2"
}
