{
  "name": "react-pdf-monorepo",
  "version": "1.0.0",
  "description": "react-pdf monorepo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "test"
  ],
  "scripts": {
    "build": "npm run build -w react-pdf",
    "dev": "npm run watch -w react-pdf",
    "format": "npm run format",
    "lint": "npm run lint",
    "tsc": "npm run tsc"
  },
  "overrides": {
    "pdfjs-dist": "4.4.168"
  },  
  "packageManager": "npm@10.2.3"
}
